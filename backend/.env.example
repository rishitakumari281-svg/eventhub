# Copy this file to ".env" in this folder (backend/.env), or run: bash configure-env.sh
# backend/.env is git-ignored. NEVER commit it or paste its contents anywhere public.
# Format: KEY=value, one per line, no quotes. A backslash in a value must be written twice (\\).
DB_USER=root
DB_PASSWORD=your-mysql-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional: only used to load demo data into an EMPTY database. An existing database is never reseeded.
# SEED_DEMO=true
# SEED_PASSWORD=ChooseSomething1
